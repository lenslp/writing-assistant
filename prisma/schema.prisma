generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model HotTopic {
  id          String    @id @default(uuid()) @db.Uuid
  externalId  String    @map("external_id")
  title       String
  url         String?
  source      String
  sourceType  String    @default("rss") @map("source_type")
  heat        Int       @default(0)
  trendScore  Int       @default(0) @map("trend_score")
  summary     String?
  tags        String[]  @default([])
  publishedAt DateTime? @map("published_at")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  raw         Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([source, externalId])
  @@index([fetchedAt(sort: Desc)])
  @@index([heat(sort: Desc)])
  @@map("hot_topics")
}

model FetchJob {
  id            String    @id @default(uuid()) @db.Uuid
  jobType       String    @default("hot-topics-refresh") @map("job_type")
  status        String
  source        String?
  insertedCount Int       @default(0) @map("inserted_count")
  message       String?
  payload       Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  finishedAt    DateTime? @map("finished_at")

  @@map("fetch_jobs")
}

model Draft {
  id               String
  userId           String    @default("legacy-single-user") @map("user_id")
  domain           String    @default("科技")
  title            String
  titleCandidates  String[]  @default([]) @map("title_candidates")
  selectedAngle    String    @map("selected_angle")
  status           String
  topic            String
  topicId          String    @map("topic_id")
  tags             String[]  @default([])
  words            Int       @default(0)
  summary          String
  outline          String[]  @default([])
  body             String
  source           String
  formatting       Json
  publishedAt      DateTime? @map("published_at")
  publishedChannel String?   @map("published_channel")
  lastExportedAt   DateTime? @map("last_exported_at")
  lastExportFormat String?   @map("last_export_format")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@id([userId, id])
  @@index([status, updatedAt(sort: Desc)])
  @@index([domain, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([topicId])
  @@map("drafts")
}

model Topic {
  id        String
  userId    String   @default("legacy-single-user") @map("user_id")
  title     String
  domain    String   @default("科技")
  heat      String
  fit       Int
  reason    String
  angles    String[] @default([])
  source    String
  type      String
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, id])
  @@index([type, updatedAt(sort: Desc)])
  @@index([domain, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("topics")
}

model AppConfig {
  id              String
  userId          String   @id @default("legacy-single-user") @map("user_id")
  settings        Json
  selectedTopicId String?  @map("selected_topic_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

model UserAIProvider {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @map("user_id")
  name                     String
  providerType             String   @default("openai") @map("provider_type")
  baseUrl                  String   @map("base_url")
  encryptedApiKey          String   @map("encrypted_api_key")
  apiKeyMasked             String   @map("api_key_masked")
  model                    String
  fastModel                String   @default("") @map("fast_model")
  longformModel            String   @default("") @map("longform_model")
  isActive                 Boolean  @default(false) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("user_ai_providers")
}

model UserAIImageProvider {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id")
  name            String
  baseUrl         String   @map("base_url")
  encryptedApiKey String   @map("encrypted_api_key")
  apiKeyMasked    String   @map("api_key_masked")
  model           String
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("user_ai_image_providers")
}

model AIUsageQuota {
  userId             String   @id @map("user_id")
  monthlyTokenLimit  Int      @default(0) @map("monthly_token_limit")
  monthlyImageLimit  Int      @default(0) @map("monthly_image_limit")
  usedTokens         Int      @default(0) @map("used_tokens")
  usedImages         Int      @default(0) @map("used_images")
  period             String
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("ai_usage_quotas")
}

model AIUsageLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id")
  provider    String
  model       String
  task        String
  source      String
  tokens      Int      @default(0)
  imageCount  Int      @default(0) @map("image_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_usage_logs")
}

model WechatAuthorizedAccount {
  id                              String    @id @default(uuid()) @db.Uuid
  userId                          String    @map("user_id")
  authorizerAppId                 String    @map("authorizer_app_id")
  nickName                        String    @default("") @map("nick_name")
  avatarUrl                       String    @default("") @map("avatar_url")
  principalName                   String    @default("") @map("principal_name")
  serviceTypeInfo                 Int?      @map("service_type_info")
  verifyTypeInfo                  Int?      @map("verify_type_info")
  encryptedAuthorizerAccessToken  String    @default("") @map("encrypted_authorizer_access_token")
  encryptedAuthorizerRefreshToken String    @map("encrypted_authorizer_refresh_token")
  tokenExpiresAt                  DateTime? @map("token_expires_at")
  defaultAuthor                   String    @default("") @map("default_author")
  contentSourceUrl                String    @default("") @map("content_source_url")
  isSelected                      Boolean   @default(false) @map("is_selected")
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, authorizerAppId])
  @@index([userId, isSelected])
  @@map("wechat_authorized_accounts")
}

model WechatComponentTicket {
  componentAppId String   @id @map("component_app_id")
  verifyTicket   String   @map("verify_ticket")
  receivedAt     DateTime @default(now()) @map("received_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("wechat_component_tickets")
}
