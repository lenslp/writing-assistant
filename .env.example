NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# 邮箱登录/注册使用 Supabase Auth，请在 Supabase 控制台启用 Email provider。
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres?sslmode=require

# 用于加密托管用户自己的 AI Key 和微信 authorizer token；生产环境必须固定且妥善保管。
AI_SECRET_ENCRYPTION_KEY=

# 平台统一 AI Key。用户未配置自有 Key 时使用这些平台 Key，并进入平台额度统计。
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.5-plus
AI_MODEL_FAST=qwen-turbo
AI_MODEL_LONGFORM=qwen3.5-plus
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_IMAGE_MODEL=wan2.7-image-pro

# 微信第三方平台授权。回调地址应指向 /api/wechat/authorize/callback；
# 授权事件接收 URL 应指向 /api/wechat/component-events?token=<WECHAT_OPEN_CALLBACK_TOKEN>。
WECHAT_OPEN_COMPONENT_APP_ID=
WECHAT_OPEN_COMPONENT_APP_SECRET=
WECHAT_OPEN_AUTH_REDIRECT_URI=
WECHAT_OPEN_AUTH_STATE_SECRET=
WECHAT_OPEN_CALLBACK_TOKEN=
# 本地调试可临时填写；线上优先由 component-events 回调入库。
WECHAT_OPEN_COMPONENT_VERIFY_TICKET=

HOTLIST_ZHIHU_FALLBACK_URLS=
HOTLIST_DOUYIN_FALLBACK_URLS=
HOTLIST_TOUTIAO_FALLBACK_URLS=
HOTLIST_BAIDU_FALLBACK_URLS=
HOTLIST_RSSHUB_BASE_URLS=
HOTLIST_TWITTER_RSSBRIDGE_BASE_URLS=
HOTLIST_TWITTER_COUNTRY=worldwide
HOTLIST_TWITTER_LIMIT=20
ZHIHU_COOKIE=
